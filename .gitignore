# ================================
venv/
env/
.venv/
.env/
ENV/

# ================================
# Jupyter Notebook
# ================================
.ipynb_checkpoints/

# ================================
# Data (DO NOT COMMIT REAL DATA)
# ================================
Data/*.csv
Data/*.xlsx
Data/*.xls
Data/*.tsv
Data/*.parquet
Data/*.json

